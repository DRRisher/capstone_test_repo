# Meshy API key (server-side secret)
MESHY_API_KEY=
PORT=3000
# Max new Meshy generations per hour per visitor (protects your credits)
MESHY_MAX_PER_HOUR=10

# Supabase project settings (public anon/publishable key only; never use service_role here)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
